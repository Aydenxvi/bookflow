# Copy to .env and fill in. Never commit the real .env file.

DATABASE_URL=postgresql+asyncpg://bookflow:bookflow@localhost:5432/bookflow

# Secret used to sign BookFlow's own session JWTs. Generate a real random
# value for anything beyond local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me

# From @BotFather. Leave empty to disable real Telegram auth (demo mode still works).
TELEGRAM_BOT_TOKEN=

DEMO_MODE_ENABLED=true
DEMO_BUSINESS_SLUG=atelier

ENVIRONMENT=development
DEBUG=true
