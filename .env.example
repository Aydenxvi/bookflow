# Top-level env, consumed by docker-compose.yml. Copy to .env.
# Individual apps also have their own .env.example with more detail
# (apps/api/.env.example etc.) for running them outside Docker.

POSTGRES_USER=bookflow
POSTGRES_PASSWORD=bookflow
POSTGRES_DB=bookflow
POSTGRES_PORT=5432

# Override any of these if the defaults collide with other local Docker
# projects on your machine (common — see README.md's local-dev section).
API_PORT=8000
WEB_PORT=5173

JWT_SECRET=dev-only-insecure-secret-change-me
TELEGRAM_BOT_TOKEN=
DEMO_MODE_ENABLED=true
DEMO_BUSINESS_SLUG=atelier

# --- Real VPS deployment only (docker compose --profile prod --profile bot up -d) ---
# Leave both blank for local dev. See README.md's "Deploying to a real VPS" section.

# ENVIRONMENT=production turns OFF the dev-only CORS regex (any localhost:<port> is
# allowed in dev to tolerate the port remapping above) — in production only the
# explicit CORS_ALLOW_ORIGINS list below applies, so set it to your real domain.
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# Your server's real hostname (not "localhost", not a bare IP) — needed for Caddy's
# automatic HTTPS (Let's Encrypt) and because Telegram's Mini App webview requires a
# real HTTPS origin. A free option: <your-vps-ip-with-dashes>.sslip.io, e.g.
# 203-0-113-10.sslip.io, or a free DuckDNS subdomain.
DOMAIN=

# Once DOMAIN is set, apps/web must be built with VITE_API_BASE_URL pointing at it.
# .env files are NOT shell-expanded, so write the real value out, not "https://$DOMAIN":
# VITE_API_BASE_URL=https://203-0-113-10.sslip.io
VITE_API_BASE_URL=
